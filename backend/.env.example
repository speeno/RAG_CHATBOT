# ── LLM ─────────────────────────────────────────────
# auto: ANTHROPIC_API_KEY → OPENAI 키 → extractive(오프라인 데모용) 순으로 자동 선택
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# (anthropic) low|medium|high — 상담 답변은 low/medium 권장
LLM_EFFORT=low
# 비우면 OPENAI_API_KEY_FILE 에서 읽음
OPENAI_API_KEY=
OPENAI_API_KEY_FILE=../openaikey
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Embedding ───────────────────────────────────────
# auto: VOYAGE_API_KEY → OPENAI 키 → hash(로컬 n-gram, 데모용) 순으로 자동 선택
EMBEDDING_PROVIDER=auto
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3

# ── Retrieval / Fail-Closed ─────────────────────────
TOP_K=5
# 비우면 provider별 기본값 사용 (voyage 0.35 / openai 0.30 / local 0.40 / hash 0.22)
RETRIEVAL_SCORE_THRESHOLD=

# ── Chunking ────────────────────────────────────────
# ≈ 400~800 tokens (한국어 기준)
CHUNK_MAX_CHARS=1200
CHUNK_OVERLAP_CHARS=150

# ── Storage ─────────────────────────────────────────
# 로컬 개발: SQLite 파일. 운영(Render+Supabase): DATABASE_URL 을 설정하면 Postgres 사용(DATABASE_PATH 무시)
DATABASE_PATH=./data/rag.db
# Supabase ▸ Connect ▸ Session pooler URI (IPv4). 예) postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=
# 허용 오리진(쉼표 구분) + 정규식(Vercel Preview 도메인용). 예) CORS_ORIGIN_REGEX=https://.*\.vercel\.app
CORS_ORIGINS=http://localhost:3100,http://localhost:3000
CORS_ORIGIN_REGEX=
